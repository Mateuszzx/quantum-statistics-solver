   "source": [
    "# Example: Plot Entropy vs Temperature (k_BT) and Magnetic Field (H_a)\n",
    "# for different band fillings (n)\n",
    "\n",
    "# Select a few n values for the rows\n",
    "n_rows = [n[0], n[len(n)//2]] \n",
    "plotter.plot_3d_results(\n",
    "    results=mu_df,\n",
    "    row_param=\"H_a\",       # Vary n across rows\n",
    "    row_vals=H_a[:2],     # Specific n values\n",
    "    x_param=\"k_BT\",      # X axis\n",
    "    y_param=\"n\",       # Y axis\n",
    "    z_label=r\"$S / k_B N$\",\n",
    "    z_col=\"mu\",          # or \"entropy\" if you have calculated it\n",
    "    distros=[d.name for d in distros],\n",
    "    # figsize=(15, 10)\n",
    ")\n",
    "plt.show()"
   ]
  }
