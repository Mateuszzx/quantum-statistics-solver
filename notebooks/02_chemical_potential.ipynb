    "from pathlib import Path\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import pandas as pd\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "\n",
    "from qss.solver_options import brent_defaults\n",
    "from qss.chemical_potential import chemical_potential\n",
    "from qss.distributions import DistType, prepare_2D_lattice_data\n",
    "import tools.scientific_plot_v2 as sp\n",
    "plotter = sp.ScientificPlotter()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 22,
   "id": "d119f491",
   "metadata": {},
   "outputs": [],
   "source": [
    "MU_B  = 1# eV/T\n",
    "N = 100\n",
    "t = -1\n",
    "# t_prim = 0.25\n",
    "t_prim = 0\n",
    "\n",
    "kx = np.linspace(-np.pi, np.pi, N, endpoint=False)\n",
    "ky = np.linspace(-np.pi, np.pi, N, endpoint=False)\n",
    "e_k, _, _ = prepare_2D_lattice_data(kx, ky, t, t_prim)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 23,
   "id": "3fb56059",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Band filling values\n",
    "n_min = 0.01\n",
    "n_max = 0.999\n",
    "n_count = 40\n",
    "\n",
    "# Magnetic field values\n",
    "Ha_min = -3\n",
    "Ha_max = 3\n",
    "Ha_count = 50\n",
    "\n",
    "# Beta values\n",
    "\n",
    "beta_min =-2\n",
    "beta_max = 2\n",
    "beta_count = 5\n",
    "\n",
    "distros = [DistType.FD, DistType.FLB, DistType.NFL, DistType.NFLB, DistType.SSL]  # ND\n",
    "n  = np.array([ 0.8, 0.9], dtype=np.float64)  # NN\n",
    "# n  = np.linspace(n_min, n_max, n_count, dtype=np.float64)  # NN\n",
    "# beta = np.array([0.1, 1.0], dtype=np.float64)  # NB\n",
    "beta = np.logspace(beta_min, beta_max, beta_count, dtype=np.float64)  # NB\n",
    "H_a = np.array([0.0], dtype=np.float64) # NH\n",
    "H_a = np.logspace(Ha_min, Ha_max, Ha_count, dtype=np.float64) # NH\n",
    "# H_a = np.concat([np.array([0.8]), H_a])"
   ]
