# Minimal Doxygen config generating XML for Breathe
PROJECT_NAME           = "qss"
OUTPUT_DIRECTORY       = build/doxygen
GENERATE_XML           = YES
XML_OUTPUT             = xml
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
USE_MATHJAX            = YES
MATHJAX_RELPATH        = https://cdn.jsdelivr.net/npm/mathjax@3/es5
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
EXTRACT_ALL            = YES
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.hh *.hxx *.c *.cc *.cpp *.cxx
INPUT                  = include src
# Adjust include/src paths to your tree as needed.
